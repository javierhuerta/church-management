# =============================================
# Produccion — Variables de entorno
# =============================================
# Copiar a .env.prod y completar los valores
#
# Generar JWT_SECRET con:
#   openssl rand -hex 32

# ——— Base de datos ———
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=church_management
DB_PORT=5432

# ——— Seguridad ———
JWT_SECRET=changeme_min_16_chars

# ——— Opcionales ———
PORT=3000
CORS_ORIGIN=https://tudominio.cl
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOG_LEVEL=debug
UPLOAD_MAX_BYTES=10485760
COVER_MAX_BYTES=10485760
MAX_ATTACHMENTS_PER_EVENT=10
CACHE_TTL_DEFAULT=60000
CACHE_MAX=500

# ——— Imagenes pre-construidas (opcional) ———
# Si no se usan, docker compose construye localmente
# BACKEND_IMAGE=ghcr.io/youruser/church-management/backend:development
# FRONTEND_IMAGE=ghcr.io/youruser/church-management/frontend:development