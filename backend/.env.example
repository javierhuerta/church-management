# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=church_management

# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=dev-secret-do-not-use-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Calendar — cover image search
# Get a free key at https://unsplash.com/developers
# If unset, the "Buscar" tab in the cover image picker will be disabled.
UNSPLASH_ACCESS_KEY=
