# =============================================================================
# Database
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=church_management

# =============================================================================
# Application
# =============================================================================
PORT=3000
NODE_ENV=development

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# JWT
# =============================================================================
# Must be at least 16 characters. App will refuse to start without this.
JWT_SECRET=change-me-min-16-chars-required
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Rate limiting (ThrottlerModule)
# =============================================================================
# TTL in milliseconds for the default throttle window (default: 60000 = 1 min)
THROTTLE_TTL=60000
# Max requests per window per IP (default: 100)
THROTTLE_LIMIT=100

# =============================================================================
# Logging
# =============================================================================
# Valid values: log | error | warn | debug | verbose (default: log)
LOG_LEVEL=log

# =============================================================================
# File uploads
# =============================================================================
# Max size in bytes for general event attachments (default: 10 MB)
UPLOAD_MAX_BYTES=10485760
# Max size in bytes for cover images (default: 10 MB)
COVER_MAX_BYTES=10485760
# Max number of attachments per event (default: 10)
MAX_ATTACHMENTS_PER_EVENT=10

# =============================================================================
# In-memory cache (response caching)
# =============================================================================
# Default TTL in milliseconds (default: 60000 = 1 min)
CACHE_TTL_DEFAULT=60000
# Max number of entries in the cache store (default: 500)
CACHE_MAX=500

# =============================================================================
# Unsplash (cover image search)
# =============================================================================
# Get a free key at https://unsplash.com/developers
# If unset, the "Buscar" tab in the cover image picker will show a disabled state.
UNSPLASH_ACCESS_KEY=
